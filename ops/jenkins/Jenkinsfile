pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.INFRA_DIR = fileExists('faang-infra/k8s') ? 'faang-infra' : '.'
                }
            }
        }

        stage('Validate Homelab Overlay') {
            steps {
                dir(env.INFRA_DIR) {
                    sh 'kubectl kustomize k8s/overlays/homelab > /dev/null'
                }
            }
        }
    }
}
