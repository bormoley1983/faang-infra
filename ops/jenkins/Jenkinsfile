pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.INFRA_DIR = fileExists('faang-infra/k8s') ? 'faang-infra' : '.'
                }
            }
        }

        stage('Test Deployment Policies') {
            steps {
                dir(env.INFRA_DIR) {
                    sh 'python3 -m unittest discover -s ops/validation -p "test_*.py" -v'
                }
            }
        }

        stage('Validate Homelab Desired State') {
            steps {
                dir(env.INFRA_DIR) {
                    sh 'python3 ops/validation/validate_deployment.py'
                }
            }
        }
    }
}
