{
  "services": {
    "faang-account-service": {
      "containerPort": 8090,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME"
      ]
    },
    "faang-achievement-service": {
      "containerPort": 8085,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "USER_SERVICE_HOST",
        "USER_SERVICE_PORT"
      ]
    },
    "faang-analytics-service": {
      "containerPort": 8086,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "KAFKA_SERVERS",
        "PROJECT_SERVICE_HOST",
        "PROJECT_SERVICE_PORT",
        "REDIS_PORT",
        "REDIS_URL"
      ]
    },
    "faang-notification-service": {
      "containerPort": 8083,
      "requiredEnv": [
        "EMAIL_ENABLED",
        "KAFKA_SERVERS",
        "SMTP_HOST",
        "SMTP_PASSWORD",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMS_ENABLED",
        "TELEGRAM_BOT_NAME",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_ENABLED",
        "USER_SERVICE_HOST",
        "USER_SERVICE_PORT",
        "VONAGE_API_KEY",
        "VONAGE_API_SECRET",
        "VONAGE_API_SENDER"
      ]
    },
    "faang-payment-service": {
      "containerPort": 8082,
      "requiredEnv": [
        "CURRENCY_EXCHANGE_ACCESS_KEY",
        "CURRENCY_EXCHANGE_API_URL",
        "CURRENCY_EXCHANGE_ENABLED",
        "PAYMENT_SERVICE_PORT",
        "REDIS_PORT",
        "REDIS_URL"
      ]
    },
    "faang-post-service": {
      "containerPort": 8081,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "KAFKA_SERVERS",
        "MODERATION_AI_ENABLED",
        "MODERATION_API_URL",
        "PAYMENT_SERVICE_HOST",
        "PAYMENT_SERVICE_PORT",
        "PROJECT_SERVICE_HOST",
        "PROJECT_SERVICE_PORT",
        "REDIS_PORT",
        "REDIS_URL",
        "S3_ACCESS_KEY",
        "S3_BUCKET_NAME",
        "S3_ENDPOINT",
        "S3_SECRET_KEY",
        "SPELLCHECKER_URL",
        "USER_SERVICE_HOST",
        "USER_SERVICE_PORT"
      ]
    },
    "faang-project-service": {
      "containerPort": 8082,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "PAYMENT_SERVICE_HOST",
        "PAYMENT_SERVICE_PORT",
        "REDIS_PORT",
        "REDIS_URL",
        "S3_ACCESS_KEY",
        "S3_BUCKET_NAME",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_KEY",
        "USER_SERVICE_HOST",
        "USER_SERVICE_PORT"
      ]
    },
    "faang-url-shortener-service": {
      "containerPort": 18080,
      "requiredEnv": [
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "REDIS_PORT",
        "REDIS_URL",
        "URL_SHORTENER_BASE_URL",
        "URL_SHORTENER_PUBLIC_URL"
      ]
    },
    "faang-user-service": {
      "containerPort": 8080,
      "requiredEnv": [
        "APP_ENV",
        "DATABASE_PASSWORD",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "DATABASE_USERNAME",
        "DICEBEAR_API_URL",
        "KAFKA_SERVERS",
        "PAYMENT_SERVICE_HOST",
        "PAYMENT_SERVICE_PORT",
        "PROJECT_SERVICE_HOST",
        "PROJECT_SERVICE_PORT",
        "REDIS_PORT",
        "REDIS_URL",
        "S3_ACCESS_KEY",
        "S3_AVATAR_BUCKET_NAME",
        "S3_BUCKET_NAME",
        "S3_DOWNLOAD_PATH",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_KEY"
      ]
    }
  }
}