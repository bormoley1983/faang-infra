{
  "services": {
    "faang-account-service": {
      "containerPort": 8090,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME"]
    },
    "faang-achievement-service": {
      "containerPort": 8085,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "USER_SERVICE_HOST", "USER_SERVICE_PORT"]
    },
    "faang-analytics-service": {
      "containerPort": 8086,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "KAFKA_SERVERS", "PROJECT_SERVICE_HOST", "PROJECT_SERVICE_PORT", "REDIS_PORT", "REDIS_URL"]
    },
    "faang-notification-service": {
      "containerPort": 8083,
      "requiredEnv": ["KAFKA_SERVERS", "REDIS_PORT", "REDIS_URL", "SMTP_HOST", "SMTP_PASSWORD", "SMTP_PORT", "SMTP_USERNAME", "TELEGRAM_BOT_NAME", "TELEGRAM_BOT_TOKEN", "USER_SERVICE_HOST", "USER_SERVICE_PORT", "VONAGE_API_KEY", "VONAGE_API_SECRET", "VONAGE_API_SENDER"]
    },
    "faang-payment-service": {
      "containerPort": 8082,
      "requiredEnv": ["CURRENCY_EXCHANGE_ACCESS_KEY", "PAYMENT_SERVICE_PORT", "REDIS_PORT", "REDIS_URL"]
    },
    "faang-post-service": {
      "containerPort": 8081,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "KAFKA_SERVERS", "MINIO_ACCESS_KEY", "MINIO_BUCKET_NAME", "MINIO_SECRET_KEY", "MINIO_SERVICE_HOST", "PAYMENT_SERVICE_HOST", "PAYMENT_SERVICE_PORT", "PROJECT_SERVICE_HOST", "PROJECT_SERVICE_PORT", "REDIS_PORT", "REDIS_URL", "USER_SERVICE_HOST", "USER_SERVICE_PORT"]
    },
    "faang-project-service": {
      "containerPort": 8082,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "PAYMENT_SERVICE_HOST", "PAYMENT_SERVICE_PORT", "REDIS_PORT", "REDIS_URL", "S3_ACCESS_KEY", "S3_BUCKET_NAME", "S3_ENDPOINT", "S3_REGION", "S3_SECRET_KEY", "USER_SERVICE_HOST", "USER_SERVICE_PORT"]
    },
    "faang-url-shortener-service": {
      "containerPort": 18080,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "REDIS_PORT", "REDIS_URL"]
    },
    "faang-user-service": {
      "containerPort": 8080,
      "requiredEnv": ["DATABASE_PASSWORD", "DATABASE_SCHEMA", "DATABASE_URL", "DATABASE_USERNAME", "KAFKA_SERVERS", "PAYMENT_SERVICE_HOST", "PAYMENT_SERVICE_PORT", "PROJECT_SERVICE_HOST", "PROJECT_SERVICE_PORT", "REDIS_PORT", "REDIS_URL", "S3_ACCESS_KEY", "S3_BUCKET_NAME", "S3_ENDPOINT", "S3_REGION", "S3_SECRET_KEY"]
    }
  }
}
