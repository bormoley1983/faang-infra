{
  "registry": {
    "address": "192.0.2.24",
    "port": 5000,
    "dnsName": "registry.home.example",
    "storageNode": "node-with-persistent-storage"
  },
  "dependencies": {
    "postgresql": {
      "mode": "external",
      "address": "192.0.2.31",
      "port": 5432,
      "tls": { "mode": "disabled" },
      "credentials": {
        "mode": "secret",
        "secretName": "faang-secrets",
        "keys": ["POSTGRES_USER", "POSTGRES_PASSWORD"]
      }
    },
    "redis": {
      "mode": "external",
      "address": "192.0.2.32",
      "port": 6379,
      "tls": { "mode": "disabled" },
      "credentials": { "mode": "none" }
    },
    "elasticsearch": {
      "mode": "external",
      "address": "192.0.2.33",
      "port": 9200,
      "tls": { "mode": "insecure" },
      "credentials": {
        "mode": "secret",
        "secretName": "faang-secrets",
        "keys": ["ELASTICSEARCH_USERNAME", "ELASTICSEARCH_PASSWORD"]
      }
    },
    "kafka": {
      "mode": "external",
      "address": "192.0.2.34",
      "port": 9092,
      "tls": { "mode": "disabled" },
      "credentials": { "mode": "none" }
    },
    "minio": {
      "mode": "internal",
      "tls": { "mode": "disabled" },
      "credentials": {
        "mode": "secret",
        "secretName": "faang-secrets",
        "keys": ["MINIO_ACCESS_KEY", "MINIO_SECRET_KEY"]
      }
    }
  }
}
